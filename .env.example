REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=false

DASH_PORT=8050

MODEL_PATH=model/saint_classifier.pt
SCALER_PATH=model/scaler.pkl
ENCODER_PATH=model/encoder.pkl

# --- LLM threat reporting (Ollama — local & free) ---
# Install: https://ollama.com  then:  ollama pull llama3.2
# When Ollama isn't running, reports fall back to a deterministic template.
LLM_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT=60
